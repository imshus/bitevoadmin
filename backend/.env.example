# Copy to backend/.env and fill in. Never commit the real .env (it holds the database password).

# MongoDB connection. Either one full URI...
MONGODB_URI=
# ...or the URL plus separate credentials (the format already used in the root .env):
MONGO_DB_URL=
MONGO_DB_USER=
MONGO_DB_PASSWORD=
# Database name (default: bitevo)
MONGO_DB_NAME=bitevo

# Port for the API (default 4000; the dev script always uses 4000).
PORT=4000
# Who can connect: 127.0.0.1 (default) = only this computer; 0.0.0.0 = also phones on the same Wi-Fi.
HOST=127.0.0.1

# The built admin panel that the API also serves (default ../frontend/dist, made by `npm run build` there).
CLIENT_DIR=

# The admin panel's address(es), comma separated. Needed so the browser can send the sign-in cookie.
CLIENT_ORIGIN=http://localhost:2001

# Public address of this API, used in uploaded photo links when the panel runs on another domain.
PUBLIC_URL=

# Demo mode: seeds an empty database with demo data and simulates new orders. Set to false for real use.
DEMO_MODE=true

# Cookies: use COOKIE_SECURE=true on HTTPS. If the panel and API are on different domains,
# also set COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=7

# Set to true when running behind a proxy/load balancer (so IP addresses in Login status are right).
TRUST_PROXY=false
